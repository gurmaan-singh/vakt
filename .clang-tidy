Checks: >
  -*,bugprone-*,performance-*,modernize-*,readability-*,cppcoreguidelines-*,
  -modernize-use-trailing-return-type,-readability-identifier-length,
  -readability-magic-numbers,-cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,-bugprone-easily-swappable-parameters,
  -cppcoreguidelines-pro-type-reinterpret-cast
HeaderFilterRegex: 'include/vakt/.*'
